# ===========================================
# Visual Editor 2D - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# Application
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/graphql
NEXT_PUBLIC_WS_URL=ws://localhost:8080/graphql

# Authentication
NEXT_PUBLIC_AUTH_DOMAIN=
NEXT_PUBLIC_AUTH_CLIENT_ID=

# Security (only for production)
# Generate with: openssl rand -base64 32
# CSRF_SECRET=your-csrf-secret-here

# Docker Build Flag
# Set to "true" when building in Docker
DOCKER_BUILD=false

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_ENABLE_REALTIME_COLLAB=false
